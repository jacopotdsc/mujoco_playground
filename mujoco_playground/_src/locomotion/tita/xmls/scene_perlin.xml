<mujoco model="tita perlin scene">
  <include file="tita.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.3 0.3 0.3" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.99 0.99 0.99" rgb2="0.99 0.99 0.99" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.80 0.80 0.80" rgb2="0.99 0.99 0.99"
      markrgb="0.3 0.3 0.3" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.0"/>
    <!-- Perlin undulations with a small flat central spawn pad (radius 0.9 m,
         blended to 1.5 m) so the 2-wheel Tita (reset x,y randomised +-0.5 m)
         always spawns level, and an outer ring tapered to the plain so leaving
         the island is flush (no step). MuJoCo normalises the PNG to [0,1] at
         compile time, so the physical vertical span == elevation (size[2]).
         size = "half_x half_y elevation base"; the PNG and the geom `pos`
         values below are produced by analysis_tita/diagnostics/make_perlin_hfield.py
         -- rerun it to retune, and copy the attributes it prints. -->
    <hfield name="perlin_hfield" size="6.0000 6.0000 0.2400 0.0200" file="height_field_perlin_tita.png"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" pos="0 0 -0.1240" material="groundplane"
          contype="1" conaffinity="0" priority="1" friction="0.6" condim="3"/>
    <geom type="hfield" hfield="perlin_hfield" pos="0 0 -0.1230" quat="1 0 0 0" material="groundplane"
          contype="1" conaffinity="0" condim="3" priority="1" friction="0.6"/>
  </worldbody>
  <include file="sensor_feet.xml"/>
</mujoco>
