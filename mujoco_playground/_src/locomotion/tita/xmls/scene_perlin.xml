<mujoco model="tita perlin scene">
  <include file="tita.xml"/>

  <statistic center="0 0 0.1" extent="5.0"/>

  <visual>
    <headlight diffuse="0.3 0.3 0.3" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.99 0.99 0.99" rgb2="0.99 0.99 0.99" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.80 0.80 0.80" rgb2="0.99 0.99 0.99"
      markrgb="0.3 0.3 0.3" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.0"/>
    <!-- Uniform Perlin undulations (no island taper, no flat pad).
         size = "half_x half_y elevation base"; elevation and geom pos
         below are derived from the generated grid. -->
    <hfield name="perlin_hfield" size="5.0000 5.0000 0.1100 0.1000" file="height_field_perlin.png"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" pos="0 0 -0.0580" material="groundplane"
          contype="1" conaffinity="0" priority="1" friction="0.6" condim="3"/>
    <geom type="hfield" hfield="perlin_hfield" pos="0 0 -0.0550" quat="1 0 0 0" material="groundplane"
          contype="1" conaffinity="0" condim="3" priority="1" friction="0.6"/>
  </worldbody>
  <include file="sensor_feet.xml"/>
</mujoco>
